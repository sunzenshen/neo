// NEO volumetric smoke - pixel shader.
//
// Raymarches a CPU-simulated voxel grid (uploaded as a 2D slice atlas, since
// the material system only hands us 2D procedural textures) through the
// volume's AABB. One fragment per pixel per draw means transmittance is
// integrated along the ray: no intra-volume sorting, so no OIT problem.
//
// Samples sit on a lattice of fixed world length along each eye ray, and a
// draw owns only the lattice points whose view depth lies in its own range
// (per vertex). Draws that split the depth range between them therefore
// neither overlap nor leave a gap, and composite like one march.
//
// Scene depth comes from the engine's depth-in-dest-alpha copy
// (TEXTURE_FRAME_BUFFER_FULL_DEPTH), using exactly the encoding that
// spritecard's $DEPTHBLEND path reads, so the march stops at geometry.

// STATIC: "CONVERT_TO_SRGB"	"0..1"	[ps30][= g_pHardwareConfig->NeedsShaderSRGBConversion()] [PC]
// STATIC: "CONVERT_TO_SRGB"	"0..0"	[= 0] [XBOX]

#include "common_ps_fxc.h"

sampler AtlasSampler : register( s0 ); // atlas: R = cell weight, G = light, B = gas path length
sampler DepthSampler : register( s1 ); // frame buffer copy, depth in .a

const float4 g_EyePos       : register( c0 ); // xyz eye, w unused
const float4 g_VolMin       : register( c1 ); // xyz, w = extinction per unit at density 1
const float4 g_VolMax       : register( c2 ); // xyz, w unused
const float4 g_Grid         : register( c3 ); // x = N, y = atlas cols, z = atlas rows, w = 1/N
const float4 g_Ambient      : register( c4 ); // rgb ambient light, w = jitter enable
const float4 g_Light        : register( c5 ); // rgb directional light, w = time
const float4 g_Misc         : register( c6 ); // x = noise amp, y = noise scale, z = bloom front path length, w = debug mode
const float4 g_ScreenParams : register( c7 ); // xy = half texel, z = path length at atlas value 1, w = 1 / edge width

#define STEP_LEN  8.0f
#define MAX_STEPS 64

struct PS_INPUT
{
	float2 vPixel     : VPOS;
	float3 vWorldPos  : TEXCOORD0;
	float4 vScreenPos : TEXCOORD1;
	float4 vDepth     : TEXCOORD2; // x, y = clip Z here and at the eye; z, w = view depth here and at the eye
	float2 vZRange    : TEXCOORD3; // view depth range this draw marches, [x, y)
};

// ---------------------------------------------------------------------------
// Atlas lookup: slice z lives at tile (z % cols, z / cols).
// ---------------------------------------------------------------------------
float2 SliceUV( float2 uv, float slice )
{
	float col = fmod( slice, g_Grid.y );
	float row = floor( slice / g_Grid.y );
	return ( float2( col, row ) + uv ) / g_Grid.yz;
}

float3 SampleVolume( float3 uvw )
{
	// Keep xy inside the tile by half a texel so bilinear never bleeds into
	// the neighbouring slice.
	float halfTexel = 0.5f * g_Grid.w;
	float2 uv = clamp( uvw.xy, halfTexel, 1.0f - halfTexel );

	float z  = clamp( uvw.z * g_Grid.x - 0.5f, 0.0f, g_Grid.x - 1.0f );
	float z0 = floor( z );
	float z1 = min( z0 + 1.0f, g_Grid.x - 1.0f );
	float fz = z - z0;

	float3 s0 = tex2Dlod( AtlasSampler, float4( SliceUV( uv, z0 ), 0, 0 ) ).rgb;
	float3 s1 = tex2Dlod( AtlasSampler, float4( SliceUV( uv, z1 ), 0, 0 ) ).rgb;
	return lerp( s0, s1, fz );
}

// ---------------------------------------------------------------------------
// Cheap procedural 3D value noise for edge erosion / wisps.
// ---------------------------------------------------------------------------
float Hash3( float3 p )
{
	return frac( sin( dot( p, float3( 12.9898f, 78.233f, 37.719f ) ) ) * 43758.5453f );
}

float ValueNoise3( float3 p )
{
	float3 i = floor( p );
	float3 f = frac( p );
	f = f * f * ( 3.0f - 2.0f * f );

	float n000 = Hash3( i + float3( 0, 0, 0 ) );
	float n100 = Hash3( i + float3( 1, 0, 0 ) );
	float n010 = Hash3( i + float3( 0, 1, 0 ) );
	float n110 = Hash3( i + float3( 1, 1, 0 ) );
	float n001 = Hash3( i + float3( 0, 0, 1 ) );
	float n101 = Hash3( i + float3( 1, 0, 1 ) );
	float n011 = Hash3( i + float3( 0, 1, 1 ) );
	float n111 = Hash3( i + float3( 1, 1, 1 ) );

	float nx00 = lerp( n000, n100, f.x );
	float nx10 = lerp( n010, n110, f.x );
	float nx01 = lerp( n001, n101, f.x );
	float nx11 = lerp( n011, n111, f.x );
	float nxy0 = lerp( nx00, nx10, f.y );
	float nxy1 = lerp( nx01, nx11, f.y );
	return lerp( nxy0, nxy1, f.z );
}

// Premultiplied output for blending in gamma space. The draws of one volume
// split the ray, so each layer premultiplies its gamma color by its own alpha:
// layers of one color then sum to what a single draw would give.
float4 BlendOutput( float3 linearColor, float alpha )
{
	float3 c = float3( SrgbLinearToGamma( linearColor.r ), SrgbLinearToGamma( linearColor.g ), SrgbLinearToGamma( linearColor.b ) );
	return float4( c * alpha, alpha );
}

// Interleaved gradient noise - per-pixel march offset to trade banding for grain.
float IGN( float2 pixel )
{
	return frac( 52.9829189f * frac( dot( pixel, float2( 0.06711056f, 0.00583715f ) ) ) );
}

float4 main( PS_INPUT i ) : COLOR
{
	// --- eye ray --------------------------------------------------------
	float3 toVert   = i.vWorldPos - g_EyePos.xyz;
	float  distVert = length( toVert );
	float3 rd       = toVert / distVert;
	float3 ro       = g_EyePos.xyz;

	// --- screen uv + scene depth ---------------------------------------
	float2 screenUV = i.vScreenPos.xy / i.vScreenPos.w;
	screenUV = screenUV * float2( 0.5f, -0.5f ) + 0.5f + g_ScreenParams.xy;

	float sceneA = tex2D( DepthSampler, screenUV ).a;

	// Clip Z and view depth are affine along the ray. Dest alpha of ~0
	// (cleared/sky) or ~1 (saturated range) both mean "nothing in front of us".
	float dClipZ = ( i.vDepth.x - i.vDepth.y ) / distVert;
	float dViewZ = ( i.vDepth.z - i.vDepth.w ) / distVert;
	float tScene = 1.0e9f;
	if ( sceneA > 0.002f && sceneA < 0.995f && abs( dClipZ ) > 1.0e-6f )
	{
		float sceneClipZ = sceneA / OO_DESTALPHA_DEPTH_RANGE;
		tScene = ( sceneClipZ - i.vDepth.y ) / dClipZ;
	}

	// --- AABB slab test -------------------------------------------------
	float3 invDir = 1.0f / rd;
	float3 tA = ( g_VolMin.xyz - ro ) * invDir;
	float3 tB = ( g_VolMax.xyz - ro ) * invDir;
	float3 tNear = min( tA, tB );
	float3 tFar  = max( tA, tB );
	float t0 = max( max( tNear.x, tNear.y ), tNear.z );
	float t1 = min( min( tFar.x,  tFar.y  ), tFar.z  );

	t0 = max( t0, 0.0f );        // camera may be inside the box
	t1 = min( t1, tScene );      // stop at opaque geometry

	int debugMode = (int)g_Misc.w;
	if ( debugMode == 2 )
	{
		// Visualise the depth we think the scene has (grey = closer).
		float v = saturate( tScene / 2048.0f );
		return BlendOutput( v.xxx, 1.0f );
	}

	if ( t1 <= t0 || dViewZ <= 1.0e-6f )
	{
		return float4( 0, 0, 0, 0 ); // premultiplied: leaves the frame buffer untouched
	}

	// --- lattice ------------------------------------------------------------
	// Point n sits at t = ( n + jitter ) * STEP_LEN and stands for the cell of
	// one step around it. This draw owns the points inside its depth range;
	// each cell is clipped to the box and the scene, so clipping stays soft.
	// The range ends are whole units, rounded so every draw sees the same value.
	float jitter = ( g_Ambient.w > 0.5f ) ? IGN( i.vPixel + g_Light.w * 100.0f ) : 0.5f;
	float2 zRange = floor( i.vZRange + 0.5f );
	float tLo = ( zRange.x - i.vDepth.w ) / dViewZ;
	float tHi = ( zRange.y - i.vDepth.w ) / dViewZ;

	float nFirst = max( ceil( tLo / STEP_LEN - jitter ), ceil( t0 / STEP_LEN - 0.5f - jitter ) );
	float nEnd   = min( ceil( tHi / STEP_LEN - jitter ), ceil( t1 / STEP_LEN + 0.5f - jitter ) );
	if ( nEnd <= nFirst )
	{
		return float4( 0, 0, 0, 0 );
	}

	if ( debugMode == 3 )
	{
		return BlendOutput( float3( 0.2f, 0.6f, 0.2f ), 0.6f );
	}

	// --- march ------------------------------------------------------------
	float3 volSize = g_VolMax.xyz - g_VolMin.xyz;

	float  T   = 1.0f;          // transmittance
	float3 col = float3( 0, 0, 0 );
	float  time = g_Light.w;

	// No break or continue: on linux-8845hs (DXVK, d3dcompiler_43 output) a
	// break in this loop never fired, so every iteration is guarded instead.
	float n = nFirst;
	[loop]
	for ( int s = 0; s < MAX_STEPS; s++ )
	{
		float tc  = ( n + jitter ) * STEP_LEN;
		float c0  = max( tc - 0.5f * STEP_LEN, t0 );
		float c1  = min( tc + 0.5f * STEP_LEN, t1 );
		float len = c1 - c0;
		if ( n < nEnd && T >= 0.005f && len > 0.0f )
		{
			float3 p   = ro + rd * ( 0.5f * ( c0 + c1 ) );
			float3 uvw = ( p - g_VolMin.xyz ) / volSize;

			// Density: the cell weight behind a soft edge at the bloom front.
			float3 v = SampleVolume( uvw );
			float d  = v.r * smoothstep( 0.0f, 1.0f, saturate( ( g_Misc.z - v.b * g_ScreenParams.z ) * g_ScreenParams.w ) );

			if ( d > 0.001f )
			{
				// Erode with animated noise so cell boundaries read as wisps.
				float nz = ValueNoise3( p * g_Misc.y + float3( 0.0f, 0.0f, -time * 0.35f ) );
				d = saturate( d * 1.25f - g_Misc.x * nz );

				float sigma = d * g_VolMin.w * len;
				float a     = 1.0f - exp( -sigma );

				float3 lit = g_Ambient.rgb + g_Light.rgb * v.g;
				col += T * a * lit;
				T   *= 1.0f - a;
			}
		}
		n += 1.0f;
	}

	if ( debugMode == 1 )
	{
		return BlendOutput( float3( 1.0f, 1.0f, 1.0f ), 1.0f - T );
	}

	// Premultiplied output; shader sets ONE / ONE_MINUS_SRC_ALPHA.
	float alpha = 1.0f - T;
	return BlendOutput( col / max( alpha, 1.0e-5f ) * LINEAR_LIGHT_SCALE, alpha );
}
