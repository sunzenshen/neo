// NEO volumetric smoke - vertex shader.
//
// The client draws the world-space AABB of a smoke volume with an identity
// model matrix, so vPos *is* the world position. We hand the pixel shader
// everything it needs to build a per-pixel eye ray and to compare against the
// engine's depth-in-dest-alpha encoding without any extra matrices:
//
//   clip-space Z is affine in world position, so interpolating it as a
//   TEXCOORD (perspective-correct) gives the exact clip Z of the surface point,
//   and clip Z of the eye itself is a constant we can compute here.

#include "common_vs_fxc.h"

struct VS_INPUT
{
	float4 vPos : POSITION;
};

struct VS_OUTPUT
{
	float4 vProjPos   : POSITION;
	float3 vWorldPos  : TEXCOORD0;
	float4 vScreenPos : TEXCOORD1; // projPos, for screen UV reconstruction
	float2 vClipZ     : TEXCOORD2; // x = clip Z at this vertex, y = clip Z at the eye
};

VS_OUTPUT main( const VS_INPUT v )
{
	VS_OUTPUT o = (VS_OUTPUT)0;

	float4 worldPos = float4( v.vPos.xyz, 1.0f );
	float4 projPos  = mul( worldPos, cModelViewProj );

	o.vProjPos   = projPos;
	o.vWorldPos  = worldPos.xyz;
	o.vScreenPos = projPos;
	o.vClipZ.x   = projPos.z;
	o.vClipZ.y   = mul( float4( cEyePos, 1.0f ), cModelViewProj ).z;

	return o;
}
